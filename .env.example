PROFILE=cpu_light
OFFLINE_MODE=true
NLU_MODE=llm
LLM_BASE_URL=http://127.0.0.1:11434
LLM_MODEL=qwen2.5:3b-instruct
MAX_CONCURRENT_CALLS=1
NOTICE_DETAIL=minimal
PUBLIC_BASE_URL=http://127.0.0.1:8000
# Relative SQLite paths are resolved from the repository root, not the launch directory.
DATABASE_URL=sqlite:///./data/callagent.db
# Required for dashboard access; generate each key once and keep them in the local .env only.
# Encryption key: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
DATA_ENCRYPTION_KEY=
# Session signing key: python -c "import secrets; print(secrets.token_urlsafe(32))"
SESSION_SECRET=
# Dashboard bootstrap account; password is Argon2-hashed in the local database.
OWNER_NAME=
OWNER_COMPANY=
OWNER_PASSWORD=
TELEGRAM_BOT_TOKEN=
